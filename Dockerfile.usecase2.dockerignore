# Exclude everything by default, then allow only what the build needs
*

# Allow sentinel package
!sentinel/
sentinel/.venv
sentinel/**/__pycache__
sentinel/**/*.pyc
sentinel/.pytest_cache
sentinel/tests/
sentinel/storage/
sentinel/**/*.pt
sentinel/**/*.pkl
sentinel/**/*.joblib
**/*.egg-info/
**/.pytest_cache/

# Allow usecase-2 source
!usecase-2/
usecase-2/node_modules
usecase-2/**/node_modules
usecase-2/infra/
usecase-2/.env.local
usecase-2/*.md
