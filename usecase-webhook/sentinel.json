{
  "sentinel": {
    "schema_version": 1,
    "storage_path": "~/.sentinel/usecase-webhook",

    "redis": {
      "host": "localhost",
      "port": 6379
    },

    "aws": {
      "region": "us-east-1"
    },

    "dashboard": {
      "enabled": true,
      "host": "0.0.0.0",
      "port": 8890
    },

    "control_plane": {
      "enabled": true
    },

    "alarm_queue": {
      "type": "sqs",
      "resource": "${SQS_BASE_URL}/sentinel-alarms"
    },

    "correlation_engines": [
      {
        "_comment": "engine01 — consumes from uc2-engine01-input (shared with usecase-2). Publishes CorrelatedPairs to uc2-agent01-pairs.",
        "name": "engine01",
        "inputs": [
          { "name": "data", "transport": { "type": "sqs", "resource": "${SQS_BASE_URL}/uc2-engine01-input" }, "correlation_field": "id", "correlation_mode": "normal" }
        ],
        "correlation_ttl_s": 180,
        "destinations": [
          { "type": "sqs", "resource": "${SQS_BASE_URL}/uc2-agent01-pairs" }
        ]
      },
      {
        "_comment": "engine02 — consumes from uc2-engine02-input (shared with usecase-2). Publishes CorrelatedPairs to uc2-agent02-pairs.",
        "name": "engine02",
        "inputs": [
          { "name": "data", "transport": { "type": "sqs", "resource": "${SQS_BASE_URL}/uc2-engine02-input" }, "correlation_field": "id", "correlation_mode": "normal" }
        ],
        "correlation_ttl_s": 180,
        "destinations": [
          { "type": "sqs", "resource": "${SQS_BASE_URL}/uc2-agent02-pairs" }
        ]
      }
    ],

    "agents": [
      {
        "_comment": "webhook_success_watcher — monitors webhook payloads with successful responses. IF detects operational anomalies; vae_semantic detects semantic inconsistencies.",
        "name": "webhook_success_watcher",
        "pairs_queue": { "type": "sqs", "resource": "${SQS_BASE_URL}/uc2-agent01-pairs" },
        "test_buffer_size": 150,
        "cortex": [{ "host": "${UCWH_ENGINE_HOST:-localhost}", "port": 50060 }],
        "reporting": {
          "heartbeat_interval_s": 15,
          "send_all_events": false
        },
        "denial_rules": [
          {
            "name": "finished_but_not_executed",
            "condition": "input.status == 'success' and input.executed == False",
            "score": -1.0
          }
        ],
        "detectors": [
          {
            "name": "if_operational",
            "algorithm": "isolation_forest",
            "phase": "TRAINING",
            "training_window": 500,
            "test_buffer_size": 100,
            "anomaly_threshold": -0.1,
            "n_estimators": 100,
            "contamination": "auto",
            "auto_infer_fp_threshold": 0.05,
            "denial_buffer_size": 200,
            "min_denial_recall": 0.5
          }
        ]
      },
      {
        "_comment": "webhook_failure_watcher — monitors webhook payloads with failed responses. IF detects operational anomalies; svdd_compact detects anomalies in latent space.",
        "name": "webhook_failure_watcher",
        "pairs_queue": { "type": "sqs", "resource": "${SQS_BASE_URL}/uc2-agent02-pairs" },
        "test_buffer_size": 150,
        "cortex": [{ "host": "${UCWH_ENGINE_HOST:-localhost}", "port": 50060 }],
        "reporting": {
          "heartbeat_interval_s": 15,
          "send_all_events": false
        },
        "denial_rules": [
          {
            "name": "automation_failed",
            "condition": "input.status == 'failed'",
            "score": -1.0
          }
        ],
        "detectors": [
          {
            "name": "if_operational",
            "algorithm": "isolation_forest",
            "phase": "TRAINING",
            "training_window": 500,
            "test_buffer_size": 100,
            "anomaly_threshold": -0.1,
            "n_estimators": 100,
            "contamination": "auto",
            "auto_infer_fp_threshold": 0.05,
            "denial_buffer_size": 200,
            "min_denial_recall": 0.5
          }
        ]
      }
    ],

    "temporal_layers": [
      {
        "_comment": "temporal01 — aggregates webhook_success_watcher and webhook_failure_watcher signals. 4 buckets × 2 min = 8 min cycle. Reports to cortex01.",
        "name": "temporal01",
        "grpc_port": 50060,
        "inputs": ["webhook_success_watcher", "webhook_failure_watcher"],
        "cortex": [{ "host": "${UCWH_ENGINE_HOST:-localhost}", "port": 50051 }],
        "silence_threshold_s": 45.0,
        "heartbeat_interval_s": 15,
        "bucket": {
          "count": 4,
          "duration_seconds": 120,
          "min_observations": 2,
          "ema_alpha": 0.3
        },
        "anomaly_rate_z_threshold": 2.0,
        "volume_z_threshold": 2.5,
        "avg_score_z_threshold": 2.0,
        "avg_latency_z_threshold": 2.5,
        "throughput_z_threshold": 2.5
      }
    ],

    "cortex": [
      {
        "_comment": "cortex01 — monitors temporal01. Detects cascades and systemic failure patterns across webhook success and failure watchers.",
        "name": "cortex01",
        "grpc_port": 50051,
        "inputs": ["temporal01"],
        "silence_threshold_s": 45,
        "test_buffer_size": 200,
        "training_sample_interval_s": 5,
        "adaptation_mode": "fine_tuning",
        "adaptation": {
          "fine_tuning_interval": 100,
          "fine_tuning_epochs": 8,
          "fine_tuning_lr": 0.0001,
          "replay_ratio": 0.3,
          "replay_buffer_size": 500
        }
      }
    ]
  }
}
