{
  "sentinel": {
    "schema_version": 1,
    "storage_path": "~/.sentinel/usecase",

    "redis": {
      "host": "localhost",
      "port": 6379
    },

    "aws": {
      "region": "us-east-1"
    },

    "dashboard": {
      "enabled": true,
      "host": "0.0.0.0",
      "port": 8888
    },

    "control_plane": {
      "enabled": true
    },

    "alarm_queue": {
      "type": "sqs",
      "resource": "${SQS_BASE_URL}/sentinel-alarms"
    },

    "model": {
      "max_versions": 10,
      "auto_rollback": true,
      "isolation_forest": {
        "n_estimators": 100,
        "contamination": "auto",
        "anomaly_threshold": -0.1,
        "training_window": 1000
      },
      "autoencoder": {
        "hidden_dim": 32,
        "training_window": 2000,
        "learning_rate": 0.001,
        "epochs": 30
      }
    },

    "correlation_engines": [
      {
        "_comment": "engine01 — APP02 enricher (1:1, 180s). Normal mode: correlates individual input→output by correlationId.",
        "name": "engine01",
        "input":  { "type": "sqs", "resource": "${SQS_BASE_URL}/sentinel-a01-in"  },
        "output": { "type": "sqs", "resource": "${SQS_BASE_URL}/sentinel-a01-out" },
        "correlation_field": "correlationId",
        "correlation_mode": "normal",
        "correlation_ttl_s": 180,
        "destinations": [
          { "type": "sqs", "resource": "${SQS_BASE_URL}/sentinel-a01-pairs" }
        ]
      },
      {
        "_comment": "engine02 — APP03 batcher (N:1, 1800s). Grouping: multiple APP02 inputs → one APP03 batch output (records[*].correlationId).",
        "name": "engine02",
        "input":  { "type": "sqs", "resource": "${SQS_BASE_URL}/sentinel-a02-in"  },
        "output": { "type": "sqs", "resource": "${SQS_BASE_URL}/sentinel-a02-out" },
        "correlation_field": "correlationId",
        "output_correlation_field": "records.correlationId",
        "correlation_mode": "grouping",
        "correlation_ttl_s": 1800,
        "destinations": [
          { "type": "sqs", "resource": "${SQS_BASE_URL}/sentinel-a02-pairs" }
        ]
      },
      {
        "_comment": "engine03 — APP04 validator (N:1, 600s). Grouping: individual APP02 outputs (sns02→sentinel-a03-in) correlated with APP04 batch output (sns04→sentinel-a03-out, records[*].correlationId).",
        "name": "engine03",
        "input":  { "type": "sqs", "resource": "${SQS_BASE_URL}/sentinel-a03-in"  },
        "output": { "type": "sqs", "resource": "${SQS_BASE_URL}/sentinel-a03-out" },
        "correlation_field": "correlationId",
        "output_correlation_field": "records.correlationId",
        "correlation_mode": "grouping",
        "correlation_ttl_s": 600,
        "destinations": [
          { "type": "sqs", "resource": "${SQS_BASE_URL}/sentinel-a03-pairs" }
        ]
      },
      {
        "_comment": "engine04 — full pipeline (N:1, 900s). Grouping: APP01 raw inputs correlated with APP04 batch output (records[*].correlationId).",
        "name": "engine04",
        "input":  { "type": "sqs", "resource": "${SQS_BASE_URL}/sentinel-a04-in"  },
        "output": { "type": "sqs", "resource": "${SQS_BASE_URL}/sentinel-a04-out" },
        "correlation_field": "correlationId",
        "output_correlation_field": "records.correlationId",
        "correlation_mode": "grouping",
        "correlation_ttl_s": 900,
        "destinations": [
          { "type": "sqs", "resource": "${SQS_BASE_URL}/sentinel-a04-pairs" }
        ]
      }
    ],

    "agents": [
      {
        "_comment": "agent01 — APP02 enricher. IF: operational baseline; cVAE: semantic consistency of output vs input.",
        "name": "agent01",
        "pairs_queue": { "type": "sqs", "resource": "${SQS_BASE_URL}/sentinel-a01-pairs" },
        "test_buffer_size": 150,
        "cortex": [{ "host": "localhost", "port": 50051 }],
        "reporting": {
          "heartbeat_interval_s": 15,
          "send_all_events": false
        },
        "detectors": [
          {
            "name": "if_baseline",
            "algorithm": "isolation_forest",
            "phase": "TRAINING",
            "training_window": 1000,
            "test_buffer_size": 100,
            "anomaly_threshold": -0.1,
            "n_estimators": 100,
            "contamination": "auto",
            "auto_infer_fp_threshold": 0.05
          },
          {
            "name": "cvae_enrichment",
            "algorithm": "cvae",
            "phase": "TRAINING",
            "training_window": 500,
            "test_buffer_size": 100,
            "anomaly_threshold": 0.5,
            "hidden_dim": 32,
            "latent_dim": 8,
            "learning_rate": 0.001,
            "epochs": 30,
            "auto_infer_fp_threshold": 0.08,
            "gating_detector": "if_baseline",
            "max_challengers_rejected": 10,
            "field_map": {
              "input": ["value01", "value02", "len(somestring)"],
              "output": ["result", "stringSize"]
            }
          }
        ]
      },
      {
        "_comment": "agent02 — APP03 batcher. IF: operational batch stats; MAF: joint distribution of batch metrics.",
        "name": "agent02",
        "pairs_queue": { "type": "sqs", "resource": "${SQS_BASE_URL}/sentinel-a02-pairs" },
        "test_buffer_size": 150,
        "cortex": [{ "host": "localhost", "port": 50051 }],
        "reporting": {
          "heartbeat_interval_s": 15,
          "send_all_events": false
        },
        "detectors": [
          {
            "name": "if_batch_stats",
            "algorithm": "isolation_forest",
            "phase": "TRAINING",
            "training_window": 1000,
            "test_buffer_size": 100,
            "anomaly_threshold": -0.1,
            "n_estimators": 100,
            "contamination": "auto",
            "auto_infer_fp_threshold": 0.08
          },
          {
            "name": "maf_joint",
            "algorithm": "maf",
            "phase": "TRAINING",
            "training_window": 1500,
            "test_buffer_size": 150,
            "anomaly_threshold": 2.0,
            "hidden_dim": 64,
            "learning_rate": 0.001,
            "epochs": 30,
            "auto_infer_fp_threshold": 0.10
          }
        ]
      },
      {
        "_comment": "agent03 — APP04 validator. IF: operational baseline; cVAE: validated output consistent with enriched input.",
        "name": "agent03",
        "pairs_queue": { "type": "sqs", "resource": "${SQS_BASE_URL}/sentinel-a03-pairs" },
        "test_buffer_size": 150,
        "cortex": [
          { "host": "localhost", "port": 50051 },
          { "host": "localhost", "port": 50052 }
        ],
        "reporting": {
          "heartbeat_interval_s": 15,
          "send_all_events": false
        },
        "detectors": [
          {
            "name": "if_latency",
            "algorithm": "isolation_forest",
            "phase": "TRAINING",
            "training_window": 1000,
            "test_buffer_size": 100,
            "anomaly_threshold": -0.1,
            "n_estimators": 100,
            "contamination": "auto",
            "auto_infer_fp_threshold": 0.05
          },
          {
            "name": "cvae_validation",
            "algorithm": "cvae",
            "phase": "TRAINING",
            "training_window": 500,
            "test_buffer_size": 100,
            "anomaly_threshold": 0.1,
            "hidden_dim": 32,
            "latent_dim": 8,
            "learning_rate": 0.001,
            "epochs": 30,
            "auto_infer_fp_threshold": 0.10,
            "gating_detector": "if_latency",
            "max_challengers_rejected": 10,
            "field_map": {
              "input": ["value01", "value02", "result", "stringSize"],
              "output": ["validationStatus"]
            }
          }
        ]
      },
      {
        "_comment": "agent04 — full pipeline. IF: end-to-end latency/size; MAF: joint distribution across complete lifecycle.",
        "name": "agent04",
        "pairs_queue": { "type": "sqs", "resource": "${SQS_BASE_URL}/sentinel-a04-pairs" },
        "test_buffer_size": 100,
        "cortex": [
          { "host": "localhost", "port": 50052 },
          { "host": "localhost", "port": 50053 }
        ],
        "reporting": {
          "heartbeat_interval_s": 15,
          "send_all_events": false
        },
        "detectors": [
          {
            "name": "if_e2e",
            "algorithm": "isolation_forest",
            "phase": "TRAINING",
            "training_window": 1000,
            "test_buffer_size": 100,
            "anomaly_threshold": -0.1,
            "n_estimators": 100,
            "contamination": "auto",
            "auto_infer_fp_threshold": 0.08
          },
          {
            "name": "maf_e2e",
            "algorithm": "maf",
            "phase": "TRAINING",
            "training_window": 1000,
            "test_buffer_size": 100,
            "anomaly_threshold": 2.0,
            "hidden_dim": 64,
            "learning_rate": 0.001,
            "epochs": 30,
            "auto_infer_fp_threshold": 0.12
          }
        ]
      }
    ],

    "cortex": [
      {
        "_comment": "cortex11 — monitors agent01/02/03. Detects cascades between enrichment and downstream.",
        "name": "cortex11",
        "grpc_port": 50051,
        "inputs": ["agent01", "agent02", "agent03"],
        "silence_threshold_s": 45,
        "test_buffer_size": 300,
        "training_sample_interval_s": 5,
        "parent_cortex": [{ "host": "localhost", "port": 50053 }],
        "adaptation_mode": "fine_tuning",
        "adaptation": {
          "fine_tuning_interval": 100,
          "fine_tuning_epochs": 8,
          "fine_tuning_lr": 0.0001,
          "replay_ratio": 0.3,
          "replay_buffer_size": 500
        }
      },
      {
        "_comment": "cortex12 — monitors agent03/04. Detects anomalies in validation and end-to-end segments.",
        "name": "cortex12",
        "grpc_port": 50052,
        "inputs": ["agent03", "agent04"],
        "silence_threshold_s": 45,
        "test_buffer_size": 200,
        "training_sample_interval_s": 5,
        "parent_cortex": [{ "host": "localhost", "port": 50053 }],
        "adaptation_mode": "fine_tuning",
        "adaptation": {
          "fine_tuning_interval": 100,
          "fine_tuning_epochs": 8,
          "fine_tuning_lr": 0.0001,
          "replay_ratio": 0.3,
          "replay_buffer_size": 500
        }
      },
      {
        "_comment": "cortex21 — top-level. Monitors agent04 + cortex11/12. Systemic view.",
        "name": "cortex21",
        "grpc_port": 50053,
        "inputs": ["agent04", "cortex11", "cortex12"],
        "silence_threshold_s": 60,
        "test_buffer_size": 100,
        "training_sample_interval_s": 15,
        "adaptation_mode": "ema",
        "adaptation": {
          "ema_alpha": 0.005
        }
      }
    ]
  }
}
