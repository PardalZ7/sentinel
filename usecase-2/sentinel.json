{
  "sentinel": {
    "schema_version": 1,
    "storage_path": "~/.sentinel/usecase-2",

    "redis": {
      "host": "localhost",
      "port": 6379
    },

    "aws": {
      "region": "us-east-1"
    },

    "dashboard": {
      "enabled": true,
      "host": "0.0.0.0",
      "port": 8889
    },

    "control_plane": {
      "enabled": true
    },

    "alarm_queue": {
      "type": "sqs",
      "resource": "${SQS_BASE_URL}/sentinel-alarms"
    },

    "correlation_engines": [
      {
        "_comment": "engine01 — consumes from uc2-engine01-input (subscribed to uc2-input SNS topic). Publishes CorrelatedPairs to uc2-agent01-pairs-topic.",
        "name": "engine01",
        "inputs": [
          { "name": "data", "transport": { "type": "sqs", "resource": "${SQS_BASE_URL}/uc2-engine01-input" }, "correlation_field": "id", "correlation_mode": "normal" }
        ],
        "correlation_ttl_s": 180,
        "destinations": [
          { "type": "sqs", "resource": "${SQS_BASE_URL}/uc2-agent01-pairs" }
        ]
      },
      {
        "_comment": "engine02 — consumes from uc2-engine02-input (subscribed to uc2-input SNS topic). Publishes CorrelatedPairs to uc2-agent02-pairs-topic.",
        "name": "engine02",
        "inputs": [
          { "name": "data", "transport": { "type": "sqs", "resource": "${SQS_BASE_URL}/uc2-engine02-input" }, "correlation_field": "id", "correlation_mode": "normal" }
        ],
        "correlation_ttl_s": 180,
        "destinations": [
          { "type": "sqs", "resource": "${SQS_BASE_URL}/uc2-agent02-pairs" }
        ]
      }
    ],

    "agents": [
      {
        "_comment": "pipefy_automation_success_watcher — monitors finished automations. Denial rule fires when status=finished but executed=false (silent failure). IF detects operational anomalies; cVAE detects semantic inconsistencies in the payload.",
        "name": "success_watcher",
        "pairs_queue": { "type": "sqs", "resource": "${SQS_BASE_URL}/uc2-agent01-pairs" },
        "test_buffer_size": 150,
        "cortex": [{ "host": "${UC2_ENGINE_HOST:-localhost}", "port": 50060 }],
        "reporting": {
          "heartbeat_interval_s": 15,
          "send_all_events": false
        },
        "denial_rules": [
          {
            "name": "finished_but_not_executed",
            "condition": "input.status == 'finished' and input.executed == False",
            "score": -1.0
          }
        ],
        "detectors": [
          {
            "name": "if_operational",
            "algorithm": "isolation_forest",
            "phase": "TRAINING",
            "training_window": 500,
            "test_buffer_size": 100,
            "anomaly_threshold": -0.1,
            "n_estimators": 100,
            "contamination": "auto",
            "auto_infer_fp_threshold": 0.05,
            "denial_buffer_size": 200,
            "min_denial_recall": 0.5
          },
          {
            "_comment": "vae_semantic — unconditional VAE over all numeric payload fields (auto-discovered, no field_map). Flags events outside the learned distribution. Threshold is auto-calibrated at training (P95 of reconstruction errors × 1.5); anomaly_threshold is only the fallback before the first champion.",
            "name": "vae_semantic",
            "algorithm": "vae",
            "phase": "TRAINING",
            "training_window": 1000,
            "test_buffer_size": 150,
            "anomaly_threshold": 0.05,
            "hidden_dim": 32,
            "latent_dim": 8,
            "learning_rate": 0.001,
            "epochs": 30,
            "kl_weight": 1.0,
            "gating_detector": "if_operational",
            "denial_buffer_size": 200,
            "min_denial_recall": 0.5
          },
          {
            "_comment": "lstm_sequence — LSTM Autoencoder over windows of 10 consecutive events ([latency, input_size, output_size] per step). Detects anomalous temporal patterns: progressive degradation, atypical ordering. Only scores once the rolling window is full (cold start).",
            "name": "lstm_sequence",
            "algorithm": "lstm_ae",
            "phase": "TRAINING",
            "training_window": 500,
            "test_buffer_size": 100,
            "anomaly_threshold": 0.05,
            "sequence_length": 10,
            "hidden_dim": 32,
            "learning_rate": 0.001,
            "epochs": 30
          }
        ]
      },
      {
        "_comment": "pipefy_automation_failure_watcher — monitors failed automations. Denial rule fires immediately on status=failed. IF detects operational anomalies; cVAE detects unusual error patterns in the payload.",
        "name": "failure_watcher",
        "pairs_queue": { "type": "sqs", "resource": "${SQS_BASE_URL}/uc2-agent02-pairs" },
        "test_buffer_size": 150,
        "cortex": [{ "host": "${UC2_ENGINE_HOST:-localhost}", "port": 50060 }],
        "reporting": {
          "heartbeat_interval_s": 15,
          "send_all_events": false
        },
        "denial_rules": [
          {
            "name": "automation_failed",
            "condition": "input.status == 'failed'",
            "score": -1.0
          }
        ],
        "detectors": [
          {
            "name": "if_operational",
            "algorithm": "isolation_forest",
            "phase": "TRAINING",
            "training_window": 500,
            "test_buffer_size": 100,
            "anomaly_threshold": -0.1,
            "n_estimators": 100,
            "contamination": "auto",
            "auto_infer_fp_threshold": 0.05,
            "denial_buffer_size": 200,
            "min_denial_recall": 0.5
          },
          {
            "_comment": "svdd_compact — Deep SVDD: learns a compact hypersphere around normal events in latent space; score = distance to center. nu=0.1 means the auto-threshold sits at the P90 of training distances. Complements MAF/VAE: distance-to-normal instead of likelihood.",
            "name": "svdd_compact",
            "algorithm": "svdd",
            "phase": "TRAINING",
            "training_window": 1000,
            "test_buffer_size": 150,
            "anomaly_threshold": 0.05,
            "hidden_dim": 32,
            "latent_dim": 8,
            "learning_rate": 0.001,
            "epochs": 30,
            "nu": 0.1,
            "gating_detector": "if_operational",
            "denial_buffer_size": 200,
            "min_denial_recall": 0.5
          },
          {
            "_comment": "tcn_sequence — TCN Autoencoder (dilated causal convolutions) over windows of 10 consecutive events. Same detection target as lstm_ae with faster parallel training and stable gradients on long sequences.",
            "name": "tcn_sequence",
            "algorithm": "tcn_ae",
            "phase": "TRAINING",
            "training_window": 500,
            "test_buffer_size": 100,
            "anomaly_threshold": 0.05,
            "sequence_length": 10,
            "hidden_dim": 32,
            "latent_dim": 8,
            "kernel_size": 3,
            "learning_rate": 0.001,
            "epochs": 30
          }
        ]
      }
    ],

    "temporal_layers": [
      {
        "_comment": "temporal01 — aggregates success_watcher and failure_watcher signals. 4 buckets × 2 min = 8 min cycle. Reports to cortex01.",
        "name": "temporal01",
        "grpc_port": 50060,
        "inputs": ["success_watcher", "failure_watcher"],
        "cortex": [{ "host": "${UC2_ENGINE_HOST:-localhost}", "port": 50051 }],
        "silence_threshold_s": 45.0,
        "heartbeat_interval_s": 15,
        "bucket": {
          "count": 4,
          "duration_seconds": 120,
          "min_observations": 2,
          "ema_alpha": 0.3
        },
        "anomaly_rate_z_threshold": 2.0,
        "volume_z_threshold": 2.5,
        "avg_score_z_threshold": 2.0,
        "avg_latency_z_threshold": 2.5,
        "throughput_z_threshold": 2.5
      }
    ],

    "cortex": [
      {
        "_comment": "cortex01 — monitors temporal01. Detects cascades and systemic failure patterns across Pipefy automation success and failure watchers.",
        "name": "cortex01",
        "grpc_port": 50051,
        "inputs": ["temporal01"],
        "silence_threshold_s": 45,
        "test_buffer_size": 200,
        "training_sample_interval_s": 5,
        "adaptation_mode": "fine_tuning",
        "adaptation": {
          "fine_tuning_interval": 100,
          "fine_tuning_epochs": 8,
          "fine_tuning_lr": 0.0001,
          "replay_ratio": 0.3,
          "replay_buffer_size": 500
        }
      }
    ]
  }
}

